<UserControl x:Class="GasStation_Bransk01.Prj.UserControl_Project"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ClassConverterRegime x:Key="ConvRegime"/>
        <conv:ClassConverterStepParams x:Key="ConvStepParams"/>
        <!--<cmd:CommandBranch x:Key="cmdBranch"/>-->        
    </UserControl.Resources>

    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
        </Grid.Resources>
        <ListView x:Name="Lst"  HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" 
                                ItemsSource="{Binding Path=ClsScript.Steps}" 
                                SelectedItem="{Binding Path=ClsScript.CurrStep}" Background="#FFAFBEAF">
            <ListView.SelectedIndex>
                <Binding Path="SelectedIdx" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
            </ListView.SelectedIndex>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить"  Command="{Binding Path=CmdAddStep}" IsEnabled="{Binding Path=ClsScript.IsChangeScript}"/>
                    <MenuItem Header="Удалить" Command="{Binding Path=CmdRemoveStep}" IsEnabled="{Binding Path=ClsScript.IsChangeScript}"/>
                    <MenuItem Header="Перейти" Command="{Binding Path=CmdGoToStep}" IsEnabled="{Binding Path=ClsScript.IsGoScript}"/>
                    <MenuItem Header="Копировать" Command="{Binding Path=CmdCopyStep}" IsEnabled="{Binding Path=ClsScript.IsChangeScript}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="30" Text="{Binding Path= StepParams.NumStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="160" Text="{Binding Path='StepParams.NameStep', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Тип" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="100" ItemsSource="{Binding Source={StaticResource ConvStepParams}, Path=Items}"
                                                                  Text="{Binding Path = 'StepParams.TypeStep', Mode=TwoWay, Converter={StaticResource ConvStepParams}}">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Аварийный">
                                                    <Setter Property="Background" >
                                                        <Setter.Value>
                                                            <RadialGradientBrush RadiusX="0.9" RadiusY="0.9">
                                                                <GradientStop Color="Red" Offset="0"/>
                                                                <GradientStop Color="White" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Нормальный">
                                                    <Setter Property="Background" >
                                                        <Setter.Value>
                                                            <RadialGradientBrush RadiusX="0.9" RadiusY="0.9">
                                                                <GradientStop Color="White" Offset="1"/>
                                                                <GradientStop Color="#FF3BAA1A" Offset="0"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Время">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Width="5" Text=":"/>
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Width="5" Text=":"/>
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Камера">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Температура [град,С]" 
                                                                     Text="{Binding Path=Chambers[0].SetupTemp, UpdateSourceTrigger=PropertyChanged}">

                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Chambers[0].Heat}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Усл. переход">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="120" Content="Условия перехода"
                                                                CommandParameter="{Binding}"
                                                                Click="Button_Click" 
                                                                Command="{Binding ElementName=Lst, Path=DataContext.CmdGoBranch}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 1" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]"
                                                                     Text="{Binding Path=Rrgs[0].SetupValue, UpdateSourceTrigger=PropertyChanged}">

                                    </TextBox>
                                    <CheckBox x:Name="checkBox" IsChecked="{Binding Path=Rrgs[0].Flap.FlapView}"  
                                              Style="{DynamicResource CheckBoxFlapStyle}"           
                                              IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[0].IsFlap}" Content="CheckBox" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0"  Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>

                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 2">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]" IsReadOnly="{Binding Path=Rrgs[1].ReadOnly,Mode=OneWay}"
                                                                    Text="{Binding Path=Rrgs[1].SetupValue,UpdateSourceTrigger=PropertyChanged}">

                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Rrgs[1].Flap.FlapView}"
                                              Style="{DynamicResource CheckBoxFlapStyle}"           
                                              IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[1].IsFlap}" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 3">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]"
                                                                     Text="{Binding Path=Rrgs[2].SetupValue,UpdateSourceTrigger=PropertyChanged}">

                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Rrgs[2].Flap.FlapView}" 
                                              Style="{DynamicResource CheckBoxFlapStyle}"                             
                                              IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[2].IsFlap}" 
                                              HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 4">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]" 
                                                                     Text="{Binding Path=Rrgs[3].SetupValue,UpdateSourceTrigger=PropertyChanged}">

                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Rrgs[3].Flap.FlapView}" 
                                              Style="{DynamicResource CheckBoxFlapStyle}"           
                                              IsEnabled="{Binding Path=ConstRrgs[3].IsFlap}" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Клап.1" >
                        <GridViewColumn.CellTemplate  >
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[0].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"
                                          Height="18.125" Margin="5,0,0,0"  Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.2">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[1].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"                           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" 
                                          Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.3">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[2].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"                          
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.4">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[3].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" 
                                          Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.5">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[4].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.6">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[5].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0"  Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.7">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[6].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.8">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[7].FlapState}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0"  Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Барботер 1">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Bubblers[0].UseBubbler}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"           
                                          HorizontalAlignment="Center" Height="18.125" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Барботер 2">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Bubblers[1].UseBubbler}" 
                                          Style="{DynamicResource CheckBoxFlapStyle}"                                                                                
                                          HorizontalAlignment="Center" Height="18.125" Margin="5,0,0,0" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Загрузчик">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="checkBox" IsChecked="{Binding Path=Loaders[0].DestLoad}" Content="CheckBox" Height="24" Margin="0,0,0,1" Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24"/>
                                    <TextBox Width="30" Text="{Binding Path=Loaders[0].SetupSpeed,UpdateSourceTrigger=PropertyChanged}" Margin="1,0,0,1"/>
                                    <CheckBox x:Name="CheckBoxUnload" 
                                                                      IsChecked="{Binding Path=Loaders[0].DestUnload}" Content="CheckBox" Height="24" Margin="1,0,0,0" Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24" RenderTransformOrigin="0.5,0.5">
                                        <CheckBox.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="180"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </CheckBox.RenderTransform>
                                        <CheckBox.ContextMenu>
                                            <ContextMenu>
                                                <CheckBox />
                                            </ContextMenu>
                                        </CheckBox.ContextMenu>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
