<UserControl x:Class="SoursePrj.UserControls.UserControl_StendControll"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             MinHeight="100" MinWidth="600">
    <UserControl.Resources>
        <Style x:Key="PauseContinueCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4">
                            <TextBlock x:Name="contentText"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                Margin="{TemplateBinding Padding}"
                                Text="Пауза"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Normal state (IsChecked=false) - "Пауза" -->
                            <Trigger Property="IsChecked" Value="false">
                                <Setter TargetName="border" Property="Background" Value="LightYellow"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="contentText" Property="Foreground" Value="Black"/>
                                <Setter TargetName="contentText" Property="Text" Value="Пауза"/>
                            </Trigger>

                            <!-- Checked state (IsChecked=true) - "Продолжить" -->
                            <Trigger Property="IsChecked" Value="true">
                                <Setter TargetName="border" Property="Background" Value="LightGreen"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="contentText" Property="Foreground" Value="Black"/>
                                <Setter TargetName="contentText" Property="Text" Value="Продолжить"/>
                            </Trigger>


                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="false">
                                <Setter TargetName="border" Property="Background" Value="#F5F5F5"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="Black"/>
                                <Setter TargetName="contentText" Property="Foreground" Value="#A0A0A0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Background="#FFAFBEAF">
        <Grid.OpacityMask>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="Black" Offset="0"/>
                <GradientStop Color="White" Offset="1"/>
            </LinearGradientBrush>
        </Grid.OpacityMask>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="180"/>
            <ColumnDefinition Width="100"/>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Grid.Column="0" Margin="5" Text="Время до выгрузки" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="5" Height="25" Text="{Binding Path=ClsScript.ClsDataTime.RemainingTimeScript, Mode=OneWay}"/>

        <TextBlock Grid.Row="1" Grid.Column="0" Margin="5" Text="Время интервала техпроцесса" VerticalAlignment="Center" />
        <TextBox Grid.Row="1" Grid.Column="1" Margin="5" Height="25" Text="{Binding Path=ClsScript.ClsDataTime.RemainingTimeStep, Mode=OneWay}"/>

        <Button Grid.Row="2" Grid.Column="0" Margin="3" Content="Запуск тех. процесса"  Command="{Binding Path=CmdNextStep}" 
                                             Height="30" IsEnabled="{Binding Path=ClsScript.EnableStartTechProcess}"/>
        <CheckBox Style="{DynamicResource PauseContinueCheckBoxStyle}" Grid.Row="2" Grid.Column="1" Margin="3" IsEnabled="{Binding Path=ClsScript.EnablePauseTechProcess}"
                                             Height="30" IsChecked="{Binding Path=ClsScript.ClsDataTime.FlagPause}"/>
        <Button Grid.Row="2" Grid.Column="2" Margin="3" Content="Остановка тех. процесса" Command="{Binding Path=CmdGoToFirstStep}" 
                                             Height="30" IsEnabled="{Binding Path=ClsScript.EnableStopTechProcess}"/>

        <GroupBox Grid.Row="0" Grid.Column="3" Margin="5" Grid.RowSpan="3" Header="Системный лог">
            <ScrollViewer  x:Name="ScrollViewer"  ScrollChanged="ScrollViewer_OnScrollChanged">
                <TextBox  x:Name="TextBox_scroll"  Text="{Binding Path=ClsScript.ViewData.MessageOut}"  TextWrapping="Wrap" IsReadOnly="True"/>
            </ScrollViewer>
        </GroupBox>
    </Grid>
</UserControl>
