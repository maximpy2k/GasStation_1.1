<UserControl x:Class="SoursePrj.UserControls.UserControl_RoughingPump"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" Width="70.797" Height="85">
    <UserControl.Resources>
        <Style x:Key="CheckBoxStyleLamp" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Rectangle x:Name="rectangle" RadiusY="5" RadiusX="5" Stroke="Black">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusY="0.9" RadiusX="0.9">
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="#FFA0E65B"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.9" RadiusX="0.9">
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FFE51400"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle4" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid x:Name="grid" Margin="0,0,-2.995,0" Width="Auto">
                            <Rectangle x:Name="rectangle" RadiusY="5" RadiusX="5" Stroke="Black" Width="Auto" Margin="0">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusY="1.184" RadiusX="1.184">
                                        <GradientStop Color="#FF5AB90B" Offset="0"/>
                                        <GradientStop Color="White" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="textBlock" Margin="6.709,-1.916,0,1.307" TextWrapping="Wrap" Text="Вкл" FontWeight="Bold" HorizontalAlignment="Left" Height="Auto" VerticalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Text" TargetName="textBlock" Value="Выкл"/>
                                <Setter Property="Width" TargetName="textBlock" Value="31.767"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="2.31,-1.916,0,1.307"/>
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="1.767" RadiusX="9.23">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="Black" Offset="0.326"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Background">
                                    <Setter.Value>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="0"/>
                                            <GradientStop Color="White" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True"/>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle1" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <ControlTemplate.Resources>
                            <Storyboard x:Key="Storyboard1" RepeatBehavior="Forever">
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" Storyboard.TargetName="image">
                                    <EasingDoubleKeyFrame KeyTime="0" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="10"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="20"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="40"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="50"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="60"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="70"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="80"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="90"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="100"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1" Value="110"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="120"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="130"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="140"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="150"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="160"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="170"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="180"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="190"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="200"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="210"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="220"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="230"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="240"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="250"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="260"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="270"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="280"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.8" Value="290"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="300"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="310"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.1" Value="320"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.2" Value="330"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.3" Value="340"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.4" Value="350"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="360"/>
                                </DoubleAnimationUsingKeyFrames>
                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[2].(RotateTransform.Angle)" Storyboard.TargetName="image_Copy">
                                    <EasingDoubleKeyFrame KeyTime="0" Value="90"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.1" Value="80"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.2" Value="70"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.3" Value="50"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.4" Value="40"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.5" Value="30"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.6" Value="20"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.7" Value="10"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.8" Value="0"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:0.9" Value="-10"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1" Value="-20"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.1" Value="-30"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.2" Value="-40"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.3" Value="-50"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.4" Value="-60"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.5" Value="-70"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.6" Value="-80"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.7" Value="-90"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.8" Value="-100"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:1.9" Value="-110"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2" Value="-120"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.1" Value="-130"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.2" Value="-140"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.3" Value="-150"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.4" Value="-160"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.5" Value="-170"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.6" Value="-180"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.7" Value="-190"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.8" Value="-200"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:2.9" Value="-210"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3" Value="-220"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.1" Value="-230"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.2" Value="-240"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.3" Value="-250"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.4" Value="-260"/>
                                    <EasingDoubleKeyFrame KeyTime="0:0:3.5" Value="-270"/>
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </ControlTemplate.Resources>
                        <Grid>

                            <Image x:Name="image" RenderTransformOrigin="0.5,0.5" Source="/SoursePrj;component/Images/NasosLopast.png" Margin="-1.75,0.083,-1.417,-3.041" Height="27.5">
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>
                            <Image x:Name="image_Copy" RenderTransformOrigin="0.5,0.5" Source="/SoursePrj;component/Images/NasosLopast.png" Height="27.5" Margin="-2.167,0,-2.08,-21.209" VerticalAlignment="Bottom"
                                   >
                                <Image.RenderTransform>
                                    <TransformGroup>
                                        <ScaleTransform/>
                                        <SkewTransform/>
                                        <RotateTransform Angle="90"/>
                                        <TranslateTransform/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="Storyboard1_BeginStoryboard"/>
                                </Trigger.ExitActions>
                                <Trigger.EnterActions>
                                    <BeginStoryboard x:Name="Storyboard1_BeginStoryboard" Storyboard="{StaticResource Storyboard1}"/>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Width="70.797" Height="85" HorizontalAlignment="Left">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Настройки" Click="MenuItemOpenParams_Click"></MenuItem>
                <!--<MenuItem Header="Расширенная информация" Click="MenuItemOpenView_Click"></MenuItem>-->
            </ContextMenu>
        </Grid.ContextMenu>

        <Rectangle Stroke="Black" VerticalAlignment="Top" Fill="#FFD8D295" RadiusX="5" RadiusY="5" HorizontalAlignment="Left" Width="70.797" Height="85" Margin="0"/>
        <Image x:Name="image1" Margin="8,30,14.797,0" RenderTransformOrigin="0.5,0.5" Source="/SoursePrj;component/Images/NasosBase.png" Height="51" VerticalAlignment="Top"/>
        <CheckBox IsEnabled="False" x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=PumpSysView.WorkUseRoughingPump, Mode=OneWay}" Height="24" Margin="19,33,25.797,0" Style="{DynamicResource CheckBoxStyle1}" VerticalAlignment="Top"/>
        <Label Content="Насос 2" Margin="2,-8,5.797,0" VerticalAlignment="Top" FontSize="14" FontWeight="Bold" Height="27"/>
        <CheckBox IsChecked="{Binding Path=UseRoughingPump}" Content="CheckBox" Height="14" Margin="16.026,0,21.771,55.833" Style="{DynamicResource CheckBoxStyle4}" VerticalAlignment="Bottom"/>
        <CheckBox HorizontalAlignment="Right" Visibility="{Binding Path=PumpSysView.RoughingPumpLampVisiblity, Mode=OneWay}" IsChecked="{Binding Path=PumpSysView.RoughingPumpLamp}" IsEnabled="False" Height="19" Margin="0,64,1.797,0" Style="{DynamicResource CheckBoxStyleLamp}" VerticalAlignment="Top" Width="20"/>
    </Grid>
</UserControl>
