                                <Setter Property="VerticalAlignment" TargetName="rectangle2" Value="Stretch"/>
                                <Setter Property="Height" TargetName="rectangle2" Value="Auto"/>
                                <Setter Property="VerticalAlignment" TargetName="rectangle" Value="Bottom"/>
                                <Setter Property="Height" TargetName="rectangle" Value="17.062"/>
                                <Setter Property="VerticalAlignment" TargetName="rectangle1" Value="Bottom"/>
                                <Setter Property="Height" TargetName="rectangle1" Value="65"/>
                                <Setter Property="VerticalAlignment" TargetName="rectangle3" Value="Stretch"/>
                                <Setter Property="Height" TargetName="rectangle3" Value="Auto"/>
                                <Setter Property="Margin" TargetName="rectangle3" Value="0,-0.014,-0.096,91.188"/>
