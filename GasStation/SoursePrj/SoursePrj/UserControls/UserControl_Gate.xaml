                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="1.163">
                                        <GradientStop Color="Black"/>
                                        <GradientStop Color="#FF4B4444" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Margin="14.25,-0.003,0,0" Stroke="Black" StrokeThickness="0.1" Width="7.938" RenderTransformOrigin="0.5,0.5" Height="42.333" VerticalAlignment="Top">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="1.163">
                                        <GradientStop Color="Black"/>
                                        <GradientStop Color="#FF4B4444" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>

                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
