                                    <RadialGradientBrush RadiusX="1.163">
                                        <GradientStop Color="Black"/>
                                        <GradientStop Color="#FF4B4444" Offset="1"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <Rectangle HorizontalAlignment="Left" Margin="0.096,42.4,0,0" RadiusY="3" RadiusX="3" Stroke="Black" StrokeThickness="1" Width="34.343" Fill="#FFD8D295" Height="57.6" VerticalAlignment="Top"/>
