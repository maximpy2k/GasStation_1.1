        <CheckBox IsEnabled="True" IsChecked="{Binding Path=ChamberView.GateStatus, Mode=OneWay}" Height="271.188" Style="{DynamicResource CheckBoxStyle1}" Width="90.28"/>
        <CheckBox IsEnabled="False" IsChecked="{Binding Path=ChamberView.OpenDumperStatus, Mode=OneWay}" Height="17.25" Margin="8.25,45.375,0,0" Style="{DynamicResource CheckBoxStyle3}" VerticalAlignment="Top" Width="20"/>
        <CheckBox IsEnabled="False" IsChecked="{Binding Path=ChamberView.CloseDumperStatus, Mode=OneWay}" Height="17.25" Margin="7.875,80,0,0" Style="{DynamicResource CheckBoxStyle3}" VerticalAlignment="Top" Width="20"/>
    </Canvas>
</UserControl>
