<UserControl x:Class="SoursePrj.UserControlRrgWithoutFlap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
             mc:Ignorable="d" 
            >
    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
        <Style x:Key="CheckBoxHeating" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="rectangle" RadiusY="10" RadiusX="10" Stroke="Black" Grid.ColumnSpan="1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="2.196">
                                        <GradientStop Color="#FF1F1F1F" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="textBlock" Margin="4,-2.667,0,1.334" TextWrapping="Wrap" Text="Закрыт" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.606" RadiusX="2.663" GradientOrigin="-0.481,0.522">
                                            <GradientStop Color="#FF2C2C2C" Offset="1"/>
                                            <GradientStop Color="White" Offset="0.142"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Grid.ColumnSpan" TargetName="textBlock" Value="2"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="4.334,-2.5,-0.334,1.167"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusX="2.196">
                                            <GradientStop Color="#FF00CB12" Offset="1"/>
                                            <GradientStop Color="White"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Text" TargetName="textBlock" Value="Открыт"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="2.333,-2.5,1.667,1.167"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border Background="#FFD8D295" CornerRadius="10" >
        <Border Background="{Binding Path=RrgView.Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="1" CornerRadius="10">
        <Grid Width="166.333" Height="85.333">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Настройки" Click="MenuItemOpenProp_Click"></MenuItem>
                <MenuItem Header="Расширенная информация" Click="MenuItemOpenView_Click"></MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <TextBlock Height="22" Margin="7,6,0,0" TextWrapping="Wrap" Text="{Binding RrgNum}" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" HorizontalAlignment="Left" Width="76"/>
        <GroupBox  Header="Расход" Margin="84,30,4.333,5.333" BorderBrush="Black" FontWeight="Bold" Height="50.333">
            <GroupBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF355119" Offset="1"/>
                    <GradientStop Color="#FFB2FF66"/>
                </LinearGradientBrush>
            </GroupBox.Background>
            <TextBox x:Name="textBox_" Height="27.032" IsReadOnly="True" Margin="-1.654,0.17,-1.654,0.171" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="18" HorizontalAlignment="Center" Width="68.641"
                     Text="{Binding Path=RrgView.CurrentValue,StringFormat={}{0:0.0}}"/>
        </GroupBox>
        <GroupBox x:Name="groupBox_SetTemp" Grid.Column="0" Header="Задание" Margin="5,0,0,5" BorderBrush="Black" FontWeight="Bold" Height="49.5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="75" d:LayoutOverrides="HorizontalAlignment">
            <GroupBox.Foreground>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="Black" Offset="0"/>
                    <GradientStop Color="#FF9A5933" Offset="1"/>
                </LinearGradientBrush>
            </GroupBox.Foreground>
            <GroupBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.52,-0.337">
                    <GradientStop Color="#FF8D4319" Offset="1"/>
                    <GradientStop Color="White"/>
                </LinearGradientBrush>
            </GroupBox.Background>
            <TextBox x:Name="TextBox_SetTemp_Copy" IsReadOnly="{Binding ReadOnly,Mode=OneWay}" TextWrapping="Wrap" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="18" HorizontalAlignment="Center" Width="55" Margin="4,-0.013,4,0"
                     Text="{Binding Path=SetupValue,StringFormat={}{0:0.0}}" VerticalAlignment="Center" Height="26.553" PreviewTextInput="TextBox_SetTemp_Copy_PreviewTextInput"/>
        </GroupBox>
        <CheckBox x:Name="CheckBox_Heating" Height="22.668" Margin="0,6,8,0" Style="{DynamicResource CheckBoxHeating}" VerticalAlignment="Top" HorizontalAlignment="Right" Width="71.999"
                  IsEnabled="False"
                  IsChecked="True"/>


    </Grid>
    </Border>
    </Border>
</UserControl>
