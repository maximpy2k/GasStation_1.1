<UserControl x:Class="SoursePrj.UserControls.UserControl_FrequencyGenerator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj.UserControls"
             mc:Ignorable="d" d:DesignWidth="225" Height="175.333">
    <UserControl.Resources>
        <Style x:Key="CheckBoxHeating" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid Margin="0,0,-5.666,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="rectangle" RadiusY="10" RadiusX="10" Stroke="Black" Grid.ColumnSpan="1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="2.196">
                                        <GradientStop Color="#FF1F1F1F" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="textBlock" Margin="4,-2.667,-4.333,1.334" TextWrapping="Wrap" Text="Выкл" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="2" d:LayoutOverrides="TopMargin, BottomMargin"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.606" RadiusX="2.663" GradientOrigin="-0.481,0.522">
                                            <GradientStop Color="#FF2C2C2C" Offset="1"/>
                                            <GradientStop Color="White" Offset="0.142"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Grid.ColumnSpan" TargetName="textBlock" Value="2"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="4.334,-2.5,-0.334,1.167"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusX="2.196">
                                            <GradientStop Color="#FF00CB12" Offset="1"/>
                                            <GradientStop Color="White"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Text" TargetName="textBlock" Value="Вкл"/>
                                <Setter Property="Grid.ColumnSpan" TargetName="textBlock" Value="1"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="11,-2.5,11.503,1.167"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="0,0,0,10" d:LayoutOverrides="VerticalAlignment">
        <Grid.RowDefinitions>
            <RowDefinition Height="46*"/>
            <RowDefinition Height="55*"/>
            <RowDefinition Height="55*"/>
        </Grid.RowDefinitions>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Настройки" Click="MenuItemOpenProp_Click"></MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Rectangle Grid.RowSpan="3" RadiusY="10" RadiusX="10" Fill="#FFD8D295" Margin="0,0,0,-13" Width="225">
            <Rectangle.Stroke>
                <RadialGradientBrush>
                    <GradientStop Color="Black" Offset="1"/>
                    <GradientStop Color="White" Offset="0.1"/>
                    <GradientStop Color="White" Offset="0.157"/>
                </RadialGradientBrush>
            </Rectangle.Stroke>
        </Rectangle>

        <CheckBox x:Name="CheckBox_Heating" Margin="0,9,19,19" Style="{DynamicResource CheckBoxHeating}"            
            IsChecked="{Binding StartupSwitch}" HorizontalAlignment="Right" Width="54"/>
        <Label x:Name="label" Content="ВЧ Генератор" Margin="9.325,2.163,85.539,13.067" FontWeight="Bold" FontSize="18" d:LayoutOverrides="LeftMargin, RightMargin"/>

        <GroupBox  Header="ШИМ 1" BorderBrush="Black" FontWeight="Bold" Margin="5,36,5,0" Grid.RowSpan="2">
            <GroupBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF355119" Offset="1"/>
                    <GradientStop Color="#FFB2FF66"/>
                </LinearGradientBrush>
            </GroupBox.Background>

            <Grid Margin="0,0,97,20.5">
                <GroupBox Margin="12.5,-3.5,18.833,-17.5" Header="Импульс" BorderBrush="#FF64A803">
                    <TextBox x:Name="textBox__Copy1" Margin="0,2.167,3.015,0.421" TextWrapping="Wrap" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="16"
                        Text="{Binding ImpulsDuration1, StringFormat=\{0:0.0\}}" HorizontalAlignment="Right" Width="54.658"/>
                </GroupBox>

                <GroupBox Margin="0,-3.5,-84,-17.5" Header="Пауза" HorizontalAlignment="Right" Width="71.675" BorderBrush="#FF64A803">
                    <TextBox Margin="0,1.667,1.517,0.921" TextWrapping="Wrap" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="16"
                        Text="{Binding ImpulsDelay1, StringFormat=\{0:0.0\}}" HorizontalAlignment="Right" Width="54.658"/>
                </GroupBox>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1"  Header="ШИМ 2" BorderBrush="Black" FontWeight="Bold" Margin="5,54,5,-8" Grid.RowSpan="2">
            <GroupBox.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FF355119" Offset="1"/>
                    <GradientStop Color="#FFB2FF66"/>
                </LinearGradientBrush>
            </GroupBox.Background>

            <Grid Margin="0,0,97,20.5">
                <GroupBox Margin="12.5,-3.5,19.5,-17.5" Header="Импульс" BorderBrush="#FF64A803">
                    <TextBox x:Name="textBox__Copy2" Margin="0,2.167,3.015,0.421" TextWrapping="Wrap" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="16"
                        Text="{Binding ImpulsDuration2, StringFormat=\{0:0.0\}}" HorizontalAlignment="Right" Width="54.658"/>
                </GroupBox>

                <GroupBox Margin="0,-3.5,-84,-17.5" Header="Пауза" HorizontalAlignment="Right" Width="71.675" BorderBrush="#FF64A803">
                    <TextBox Margin="0,1.667,1.517,0.921" TextWrapping="Wrap" FontWeight="Bold" Background="{x:Null}" BorderBrush="Black" FontSize="16"
                        Text="{Binding ImpulsDelay2, StringFormat=\{0:0.0\}}" HorizontalAlignment="Right" Width="54.658"/>
                </GroupBox>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
