<UserControl x:Class="SoursePrj.UserControl_Shutter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="87.333" d:DesignWidth="130">
    <UserControl.Resources>
        <Style x:Key="CheckBoxStyle1" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Ellipse x:Name="ellipse" Stroke="Red" Opacity="0.7" Margin="1.219,1.262,0.313,0.249" StrokeThickness="3" HorizontalAlignment="Stretch" Width="Auto" Fill="{x:Null}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="{x:Null}">
                                <Setter Property="Stroke" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FFFCF002" Offset="0.936"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Stroke" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FF6EFF00" Offset="0.929"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Stroke" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush>
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FFFE0505" Offset="0.94"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Width="130" Height="87.333">
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Настройки" Click="MenuItemOpenProp_Click"></MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <Rectangle Margin="29,8,31,7.333" RadiusY="5" RadiusX="5" Stroke="Black" Fill="#FFD8D295"/>
        <local:UserControl_Pipe_Free Margin="-6,0,0,31.333" Height="3" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="32">
            <local:UserControl_Pipe_Free.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </local:UserControl_Pipe_Free.RenderTransform>
        </local:UserControl_Pipe_Free>
        <local:UserControl_Pipe_Free Margin="0,0,-6,31.333" Height="2" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" Width="33">
            <local:UserControl_Pipe_Free.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-90"/>
                    <TranslateTransform/>
                </TransformGroup>
            </local:UserControl_Pipe_Free.RenderTransform>
        </local:UserControl_Pipe_Free>
        <local:UserControl_Pipe_Free Margin="9,0,10,13.333" Height="3" VerticalAlignment="Bottom" RenderTransformOrigin="0.5,0.5">
            <local:UserControl_Pipe_Free.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="-180"/>
                    <TranslateTransform/>
                </TransformGroup>
            </local:UserControl_Pipe_Free.RenderTransform>
        </local:UserControl_Pipe_Free>
        <Grid Margin="55,0,49,9.333" IsEnabled="{Binding Path=ShutterView.FlapLttleFlapIsEnabled}">
            <local:UserControl_Flap 
             DataContext="{Binding Flaps[1]}" Height="26" VerticalAlignment="Bottom" RenderTransformOrigin="0.296,1.005">
                <local:UserControl_Flap.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
                        <SkewTransform/>
                        <RotateTransform/>
                        <TranslateTransform/>
                    </TransformGroup>
                </local:UserControl_Flap.RenderTransform>
            </local:UserControl_Flap>
        </Grid>
        <Rectangle Margin="0,0,8,12.333" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" Width="5" Stroke="Black" StrokeThickness="0.3" RadiusX="0.5" RadiusY="0.5" Height="5" VerticalAlignment="Bottom">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="360"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="2.103" RadiusX="2.332">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF545454" Offset="0.278"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Margin="7,0,0,12.333" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="5" Stroke="Black" StrokeThickness="0.3" RadiusX="0.5" RadiusY="0.5" Height="5" VerticalAlignment="Bottom">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="360"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="2.103" RadiusX="2.332">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF545454" Offset="0.278"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Label x:Name="label1" Margin="30,-0.924,30,0" VerticalAlignment="Top" FontSize="18" FontWeight="Bold" Height="35.924">
            <TextBlock x:Name="textBlock" TextWrapping="Wrap" Text="Затвор" Width="62.193" HorizontalAlignment="Center"/>
        </Label>
        <local:UserControl_PipeAir Margin="10,39.28,10,39.083"/>
        <local:UserControl_Flap Margin="50.933,34.071,53.359,27.554"
            DataContext="{Binding Flaps[0]}" RenderTransformOrigin="0.296,1.005">
            <local:UserControl_Flap.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="1.3" ScaleY="1.3"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </local:UserControl_Flap.RenderTransform>
        </local:UserControl_Flap>
        <Rectangle Margin="0,37.002,4.136,36.831" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Right" Width="13.5" Stroke="Black" StrokeThickness="0.3" RadiusX="0.5" RadiusY="0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="360"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="2.103" RadiusX="2.332">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF545454" Offset="0.278"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <Rectangle Margin="2.991,37.085,0,36.748" RenderTransformOrigin="0.5,0.5" HorizontalAlignment="Left" Width="13.5" Stroke="Black" StrokeThickness="0.3" RadiusX="0.5" RadiusY="0.5">
            <Rectangle.RenderTransform>
                <TransformGroup>
                    <ScaleTransform/>
                    <SkewTransform/>
                    <RotateTransform Angle="360"/>
                    <TranslateTransform/>
                </TransformGroup>
            </Rectangle.RenderTransform>
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="2.103" RadiusX="2.332">
                    <GradientStop Color="White"/>
                    <GradientStop Color="#FF545454" Offset="0.278"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <CheckBox IsEnabled="False" IsChecked="{Binding Path=ShutterView.OpenStatus, Mode=OneWay}" Content="CheckBox" Margin="48,25,47,27.333" Style="{DynamicResource CheckBoxStyle1}" IsThreeState="True"/>
    </Grid>
</UserControl>
