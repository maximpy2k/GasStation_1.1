        <Style x:Key="CheckBoxFireSensor" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Image x:Name="___SoursePrj_component_Fire_png" Source="/SoursePrj;component/Images/Fire.png" Stretch="Fill"/>
