<UserControl x:Class="SoursePrj.UserControls.UserControlProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj.UserControls"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:ClassConverterStepBackground x:Key="myConverter"/>
        <converters:CompareConverter x:Key="compareConverter"/>
        <Style x:Key="myItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Background">
                <Setter.Value>
                    <Binding RelativeSource="{RelativeSource Self}" 
                             Converter="{StaticResource myConverter}" ConverterParameter="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
        </Grid.Resources>

        <ListView x:Name="Lst" ItemsSource="{Binding Path=ClsScript.Steps}" SelectedItem="{Binding Path=ClsScript.CurrStep}" Background="#FFAFBEAF" DataContextChanged="Lst_DataContextChanged">
            <ListView.SelectedIndex>
                <Binding Path="SelectedIdx" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
            </ListView.SelectedIndex>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить"  Command="{Binding Path=CmdAddStep}"/>
                    <MenuItem Header="Удалить" Command="{Binding Path=CmdRemoveStep}"/>
                    <MenuItem Header="Перейти" Command="{Binding Path=CmdGoToStep}"/>
                    <MenuItem Header="Копировать" Command="{Binding Path=CmdCopyStep}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>

                    <!-- Фон -->
                    <Setter Property="Background">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource compareConverter}" 
                  ConverterParameter="Background">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                                <Binding Path="DataContext.ClsScript.RunningStepIdx" ElementName="Lst"/>
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource Self}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>

                    <!-- Цвет текста -->
                    <Setter Property="Foreground">
                        <Setter.Value>
                            <MultiBinding Converter="{StaticResource compareConverter}" 
                  ConverterParameter="Foreground">
                                <Binding Path="DataContext" RelativeSource="{RelativeSource Self}"/>
                                <Binding Path="ItemsSource" RelativeSource="{RelativeSource AncestorType=ListView}"/>
                                <Binding Path="DataContext.ClsScript.RunningStepIdx" ElementName="Lst"/>
                                <Binding Path="IsSelected" RelativeSource="{RelativeSource Self}"/>
                            </MultiBinding>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Background" Value="DeepSkyBlue"/>
                            <Setter Property="Foreground" Value="Blue"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</UserControl>
