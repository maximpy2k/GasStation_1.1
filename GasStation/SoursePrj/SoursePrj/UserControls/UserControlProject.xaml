<UserControl x:Class="SoursePrj.UserControls.UserControlProject"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj.UserControls"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="300">
    <UserControl.Resources>
        <converters:ClassConverterStepBackground x:Key="myConverter"/>
        <Style x:Key="myItemStyle" TargetType="{x:Type ListViewItem}">
            <Setter Property="Background">
                <Setter.Value>
                    <Binding RelativeSource="{RelativeSource Self}" 
                             Converter="{StaticResource myConverter}" ConverterParameter="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
        </Grid.Resources>

        <ListView x:Name="Lst" ItemsSource="{Binding Path=ClsScript.Steps}" SelectedItem="{Binding Path=ClsScript.CurrStep}" Background="#FFAFBEAF" DataContextChanged="Lst_DataContextChanged">
            <ListView.SelectedIndex>
                <Binding Path="SelectedIdx" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
            </ListView.SelectedIndex>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить"  Command="{Binding Path=CmdAddStep}"/>
                    <MenuItem Header="Удалить" Command="{Binding Path=CmdRemoveStep}"/>
                    <MenuItem Header="Перейти" Command="{Binding Path=CmdGoToStep}"/>
                    <MenuItem Header="Копировать" Command="{Binding Path=CmdCopyStep}"/>
                </ContextMenu>
            </ListView.ContextMenu>
        </ListView>
    </Grid>
</UserControl>
