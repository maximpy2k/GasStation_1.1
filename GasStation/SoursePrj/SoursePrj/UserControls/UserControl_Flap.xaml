<UserControl x:Class="SoursePrj.UserControl_Flap"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="25.708" d:DesignWidth="25.708" >
    <UserControl.Resources>
        <Style x:Key="CheckBoxStyleFlap" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <BulletDecorator>
                            <BulletDecorator.Bullet>
                                <Grid Margin="0">
                                    <Ellipse x:Name="ellipse" Stroke="#FF615E5E" Margin="0" Width="25.708" Height="25.708" HorizontalAlignment="Right" d:LayoutOverrides="Width">
                                        <Ellipse.Fill>
                                            <RadialGradientBrush RadiusY="0.662" RadiusX="0.662">
                                                <GradientStop Color="Black" Offset="1"/>
                                                <GradientStop Color="White"/>
                                            </RadialGradientBrush>
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <Label Margin="-2.498,-5.124,-1.25,1.251"  Content="{TemplateBinding Content}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Height="Auto" Width="Auto" RenderTransformOrigin="-0.052,0.544" d:LayoutOverrides="Width"/>
                                </Grid>
                            </BulletDecorator.Bullet>
                        </BulletDecorator>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Fill" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.662" RadiusX="0.662">
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FF42D100"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ContextMenu>
            <ContextMenu>
                <MenuItem Header="Настройки" Click="MenuParams"></MenuItem>
            </ContextMenu>
        </Grid.ContextMenu>
        <CheckBox x:Name="checkBox" IsEnabled="{Binding Path=EnabledChangedScript,Mode=OneWay}" HorizontalAlignment="Right" Height="25.708" 
                  Margin="0" Style="{DynamicResource CheckBoxStyleFlap}" VerticalAlignment="Bottom" Width="25.708"
                  IsChecked="{Binding FlapView}" Content="{Binding Path=FlapConst.DevNum}"/>

    </Grid>
</UserControl>
