<UserControl x:Class="SoursePrj.UserControl_PipeAir"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="12" d:DesignWidth="92.5">
    <Grid>
        <Rectangle Margin="0" RadiusY="1" RadiusX="1" Stroke="Black" StrokeThickness="0.1">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="0.821" RadiusX="1.925">
                    <GradientStop Color="Black" Offset="0.888"/>
                    <GradientStop Color="White" Offset="0.031"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
