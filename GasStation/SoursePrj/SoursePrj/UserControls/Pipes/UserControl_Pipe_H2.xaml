<UserControl x:Class="SoursePrj.UserControl_Pipe_H2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="7" d:DesignWidth="150">
    <Grid>
        <Rectangle Height="7" Margin="0" VerticalAlignment="Bottom">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="1.371" RadiusY="0.512">
                    <GradientStop Color="Black" Offset="0.924"/>
                    <GradientStop Color="#FF5FBF51" Offset="0.45"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    </Grid>
</UserControl>
