<UserControl x:Class="SoursePrj.UserControl_Pipe_H2_O2"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="6" Width="150" Height="7">
    <Grid Margin="0" Height="7">
        <Rectangle Height="7" Margin="0" VerticalAlignment="Top" Stroke="#FF3C3C3C" StrokeThickness="0.1" RadiusX="1" RadiusY="1">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusY="0.537" RadiusX="1.921">
                    <GradientStop Color="#FF35A3FF" Offset="1"/>
                    <GradientStop Color="#FF5FBF51" Offset="0.243"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
