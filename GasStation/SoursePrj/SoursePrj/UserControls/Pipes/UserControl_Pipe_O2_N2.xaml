                <RadialGradientBrush RadiusX="2.094">
                    <GradientStop Color="#FF1D98FF" Offset="0.183"/>
                    <GradientStop Color="Black" Offset="1"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

    </Grid>
