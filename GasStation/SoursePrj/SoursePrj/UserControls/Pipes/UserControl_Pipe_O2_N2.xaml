             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="7" d:DesignWidth="77.125">
    <Grid>
        <Rectangle Height="7" Margin="0" Stroke="Black" VerticalAlignment="Bottom" StrokeThickness="0.1" RadiusX="1" RadiusY="1">
