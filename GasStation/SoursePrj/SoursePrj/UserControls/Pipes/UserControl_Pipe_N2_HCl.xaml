<UserControl x:Class="SoursePrj.UserControl_Pipe_N2_HCl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SoursePrj"
             mc:Ignorable="d" 
             d:DesignHeight="7" d:DesignWidth="96">
    <Grid>
        <Rectangle Margin="0" RadiusY="1" RadiusX="1" Stroke="Black" StrokeThickness="0.1" Height="7">
            <Rectangle.Fill>
                <RadialGradientBrush RadiusX="4.342" RadiusY="0.815">
                    <GradientStop Color="#FF51876A" Offset="0.126"/>
                    <GradientStop Color="Black" Offset="0.613"/>
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
    </Grid>
</UserControl>
