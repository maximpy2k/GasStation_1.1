<Window x:Class="SoursePrj.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SoursePrj"
        xmlns:local1="clr-namespace:SoursePrj.Ульяновск.Изотрон"
        mc:Ignorable="d"
        Title="MainWindow" Height="848.655" Width="1788.09">
    <Window.Resources>
        <Style x:Key="CheckBoxStyle2" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Rectangle x:Name="rectangle" Fill="#FFD8D295" Stroke="Black"/>
                            <TextBlock x:Name="textBlock" Margin="6.999,4.223,5.53,4.61" TextWrapping="Wrap" Text="TextBlock"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="RadiusX" TargetName="rectangle" Value="10"/>
                                <Setter Property="RadiusY" TargetName="rectangle" Value="10"/>
                                <Setter Property="Effect" TargetName="rectangle">
                                    <Setter.Value>
                                        <DropShadowEffect/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Fill" TargetName="rectangle" Value="#FF5D5555"/>
                                <Setter Property="Text" TargetName="textBlock" Value="Нагрев"/>
                                <Setter Property="FontWeight" TargetName="textBlock" Value="Bold"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="3.83,0,2.866,4.583"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="RadiusX" TargetName="rectangle" Value="10"/>
                                <Setter Property="RadiusY" TargetName="rectangle" Value="10"/>
                                <Setter Property="Margin" TargetName="rectangle" Value="0"/>
                                <Setter Property="Fill" TargetName="rectangle" Value="#FF45DA00"/>
                                <Setter Property="Text" TargetName="textBlock" Value="Нагрев"/>
                                <Setter Property="FontWeight" TargetName="textBlock" Value="Bold"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="3.831,0,2.865,3.166"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle8" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Image x:Name="Fire" Source="Images/Fire.png" Stretch="Fill"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" TargetName="Fire" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxHeating" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="0*"/>
                            </Grid.ColumnDefinitions>
                            <Rectangle x:Name="rectangle" RadiusY="10" RadiusX="10" Stroke="Black" Grid.ColumnSpan="1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusX="2.196">
                                        <GradientStop Color="#FF1F1F1F" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock x:Name="textBlock" Margin="4,-2.667,0,1.334" TextWrapping="Wrap" Text="Нагрев" FontSize="18" FontWeight="Bold" Grid.ColumnSpan="1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusX="2.196">
                                            <GradientStop Color="#FF00CB12" Offset="1"/>
                                            <GradientStop Color="White"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxStyle9" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Rectangle x:Name="rectangle" RadiusY="10" RadiusX="10">
                                <Rectangle.Fill>
                                    <SolidColorBrush Color="#FFD8D295">
                                        <SolidColorBrush.RelativeTransform>
                                            <TransformGroup>
                                                <ScaleTransform CenterY="0.5" CenterX="0.5"/>
                                                <SkewTransform CenterY="0.5" CenterX="0.5"/>
                                                <RotateTransform Angle="0.075" CenterY="0.5" CenterX="0.5"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </SolidColorBrush.RelativeTransform>
                                    </SolidColorBrush>
                                </Rectangle.Fill>
                                <Rectangle.Stroke>
                                    <RadialGradientBrush>
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="White" Offset="0.1"/>
                                        <GradientStop Color="White" Offset="0.157"/>
                                    </RadialGradientBrush>
                                </Rectangle.Stroke>
                            </Rectangle>
                            <TextBlock x:Name="textBlock" Margin="22.75,3.25,20.5,3.75" TextWrapping="Wrap" Text="TextBlock" RenderTransformOrigin="0.546,0.146"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Effect" TargetName="rectangle">
                                    <Setter.Value>
                                        <DropShadowEffect/>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Text" TargetName="textBlock" Value="Закрыт"/>
                                <Setter Property="VerticalAlignment" TargetName="textBlock" Value="Stretch"/>
                                <Setter Property="Height" TargetName="textBlock" Value="Auto"/>
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusX="1.525" RadiusY="0.785" GradientOrigin="0.498,0.514">
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <ScaleTransform CenterY="0.5" CenterX="0.5" ScaleY="1" ScaleX="1"/>
                                                    <SkewTransform AngleY="0" AngleX="0" CenterY="0.5" CenterX="0.5"/>
                                                    <RotateTransform Angle="170.425" CenterY="0.5" CenterX="0.5"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                            <GradientStop Color="Black" Offset="0.814"/>
                                            <GradientStop Color="White" Offset="0.023"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Margin" TargetName="textBlock" Value="28.25,2.666,27.5,3.834"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Text" TargetName="textBlock" Value="Открыт"/>
                                <Setter Property="VerticalAlignment" TargetName="textBlock" Value="Stretch"/>
                                <Setter Property="Height" TargetName="textBlock" Value="Auto"/>
                                <Setter Property="Margin" TargetName="textBlock" Value="26.75,2.75,27.25,3.25"/>
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush GradientOrigin="0.498,0.354" RadiusY="1.072" RadiusX="0.888">
                                            <RadialGradientBrush.RelativeTransform>
                                                <TransformGroup>
                                                    <ScaleTransform CenterY="0.5" CenterX="0.5" ScaleY="1" ScaleX="1"/>
                                                    <SkewTransform AngleY="0" AngleX="0" CenterY="0.5" CenterX="0.5"/>
                                                    <RotateTransform Angle="0.773" CenterY="0.5" CenterX="0.5"/>
                                                    <TranslateTransform/>
                                                </TransformGroup>
                                            </RadialGradientBrush.RelativeTransform>
                                            <GradientStop Color="Black" Offset="0.804"/>
                                            <GradientStop Color="#FF3EFF1F" Offset="0"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Effect" TargetName="rectangle">
                                    <Setter.Value>
                                        <DropShadowEffect/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBox_WaterError" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Ellipse x:Name="ellipse" Stroke="Black" StrokeThickness="0.1">
                                <Ellipse.Fill>
                                    <RadialGradientBrush RadiusY="0.527" RadiusX="0.567">
                                        <GradientStop Color="#FF1150F4" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <Image x:Name="image" Margin="10.373,3.919,10.374,5.081" Source="Images/DropWater.png" HorizontalAlignment="Stretch"/>
                            <Image x:Name="image_Copy" Margin="7,2" Source="Images/CrossCancel.png" HorizontalAlignment="Stretch"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" TargetName="image_Copy" Value="0"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Margin" TargetName="image" Value="5.54,4.358,5.541,4.644"/>
                                <Setter Property="HorizontalAlignment" TargetName="image_Copy" Value="Stretch"/>
                                <Setter Property="Width" TargetName="image_Copy" Value="Auto"/>
                                <Setter Property="Margin" TargetName="image_Copy" Value="7,2"/>
                                <Setter Property="Fill" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.527" RadiusX="0.567">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#FFF70000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" TargetName="image" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxFlap" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Ellipse x:Name="ellipse" Stroke="#FF615E5E">
                                <Ellipse.Fill>
                                    <RadialGradientBrush RadiusY="0.662" RadiusX="0.662">
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock x:Name="textBlock" Margin="5.917,-1.418,6.313,4.083" TextWrapping="Wrap" Text="6" FontSize="18" FontWeight="Bold" Width="Auto"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Fill" TargetName="ellipse">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.662" RadiusX="0.662">
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FF54F119"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Stroke" TargetName="ellipse" Value="#FF616161"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxFlap3" TargetType="{x:Type CheckBox}"/>
    </Window.Resources>
    <StackPanel>
        <local1:UserControl_IzotronUlyanovskVK/>
    </StackPanel>
</Window>