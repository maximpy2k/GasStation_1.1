                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="0.527" RadiusX="0.567">
                                            <GradientStop Color="White" Offset="0"/>
                                            <GradientStop Color="#FFF70000" Offset="1"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="Opacity" TargetName="image" Value="0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
