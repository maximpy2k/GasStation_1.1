<UserControl x:Class="GasStation_IsotronVK.UserControl_Project"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"          
             xmlns:conv="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
             mc:Ignorable="d">
    <UserControl.Resources>
        <conv:ClassConverterRegime x:Key="ConvRegime"/>
        <conv:ClassConverterStepParams x:Key="ConvStepParams"/>

        <Style x:Key="CheckBoxStyle1" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Rectangle x:Name="rectangle" Stroke="Black" Margin="0" StrokeThickness="0.1" RadiusX="0.2" RadiusY="0.2" Opacity="0.8">
                                <Rectangle.Fill>
                                    <RadialGradientBrush RadiusY="0.981" RadiusX="1.006">
                                        <GradientStop Color="Black" Offset="1"/>
                                        <GradientStop Color="White"/>
                                    </RadialGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content=""/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="False"/>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Fill" TargetName="rectangle">
                                    <Setter.Value>
                                        <RadialGradientBrush RadiusY="1.121" RadiusX="1.161">
                                            <GradientStop Color="Black" Offset="1"/>
                                            <GradientStop Color="#FFA5EC5E"/>
                                        </RadialGradientBrush>
                                    </Setter.Value>
                                </Setter>
                                <Setter Property="StrokeThickness" TargetName="rectangle" Value="0.5"/>
                                <Setter Property="RadiusX" TargetName="rectangle" Value="0.2"/>
                                <Setter Property="RadiusY" TargetName="rectangle" Value="0.2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CheckBoxLoad" TargetType="{x:Type CheckBox}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <Grid>
                            <Rectangle Fill="#FFF4F4F5" Stroke="Black"/>
                            <Image x:Name="image" Margin="1" Source="/SoursePrj;component/Images/Right.png"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"/>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Opacity" TargetName="image" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.Resources>
            <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
        </Grid.Resources>
        
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <ListView x:Name="Lst" HorizontalAlignment="Stretch"  VerticalAlignment="Stretch" 
                                ItemsSource="{Binding Path=ClsScript.Steps}" 
                                SelectedItem="{Binding Path=ClsScript.CurrStep}" Background="#FFAFBEAF" Grid.ColumnSpan="2">
            <ListView.SelectedIndex>
                <Binding Path="SelectedIdx" Mode="TwoWay" UpdateSourceTrigger="PropertyChanged"/>
            </ListView.SelectedIndex>
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Добавить"  Command="{Binding Path=CmdAddStep}"/>
                    <MenuItem Header="Удалить" Command="{Binding Path=CmdRemoveStep}"/>
                    <MenuItem Header="Перейти" Command="{Binding Path=CmdGoToStep}"/>
                    <MenuItem Header="Копировать" Command="{Binding Path=CmdCopyStep}"/>
                </ContextMenu>
            </ListView.ContextMenu>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Номер шага">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="70" Text="{Binding Path= StepParams.NumStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="False"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Название шага">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Width="188" Text="{Binding Path='StepParams.NameStep', Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Тип интервала" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox Width="100" ItemsSource="{Binding Source={StaticResource ConvStepParams}, Path=Items}"
                                                                  Text="{Binding Path = 'StepParams.TypeStep', Mode=TwoWay, Converter={StaticResource ConvStepParams}}">
                                    <ComboBox.Resources>
                                        <Style TargetType="ComboBox">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="Аварийный">
                                                    <Setter Property="Background" >
                                                        <Setter.Value>
                                                            <RadialGradientBrush RadiusX="0.9" RadiusY="0.9">
                                                                <GradientStop Color="Red" Offset="0"/>
                                                                <GradientStop Color="White" Offset="1"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                                <Trigger Property="Text" Value="Нормальный">
                                                    <Setter Property="Background" >
                                                        <Setter.Value>
                                                            <RadialGradientBrush RadiusX="0.9" RadiusY="0.9">
                                                                <GradientStop Color="White" Offset="1"/>
                                                                <GradientStop Color="#FF3BAA1A" Offset="0"/>
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Resources>
                                </ComboBox>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Время шага">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepH, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput"/>
                                    <TextBlock Width="5" Text=":"/>
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepM, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_1"/>
                                    <TextBlock Width="5" Text=":"/>
                                    <TextBox Width="30" Text="{Binding Path=StepParams.TimeStepS, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_2"/>

                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Камера">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel  Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Температура [град,С]" 
                                                                     Text="{Binding Path=Chambers[0].SetupTemp, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_7">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>

                                                <MenuItem Header="Параметры камеры" 
                                                                              Command="{Binding Path=CmdMenuChamberParams}" 
                                                                              CommandParameter="{Binding Path=Chambers[0]}"/>

                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Chambers[0].Heat}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Усл. переход">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Button Width="120" Content="Условия перехода"
                                                                CommandParameter="{Binding}"                                                                
                                                                Command="{Binding ElementName=Lst, Path=DataContext.CmdGoBranch}"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Вак.насос" >
                        <GridViewColumn.CellTemplate  >
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=PumpSys[0].UseVacuumPump}" 
                                                                      Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Форвак.насос" >
                        <GridViewColumn.CellTemplate  >
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=PumpSys[0].UseRoughingPump}" 
                                                                      Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="РРГ 1" >
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]" IsReadOnly="{Binding Path=Rrgs[0].ReadOnly,Mode=OneWay}"
                                                                     Text="{Binding Path=Rrgs[0].SetupValue, UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_3">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Параметры" 
                                                                              Command="{Binding CmdRrgStepParams}" 
                                                                              CommandParameter="{Binding Path=Rrgs[0]}"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <CheckBox x:Name="checkBox" IsChecked="{Binding Path=Rrgs[0].Flap.FlapView}"  
                                                                      IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[0].IsFlap}" Content="CheckBox" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>

                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 2">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]" IsReadOnly="{Binding Path=Rrgs[1].ReadOnly,Mode=OneWay}"
                                                                     
                                                                 
                                                                     Text="{Binding Path=Rrgs[1].SetupValue,UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_4">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Параметры" 
                                                                              Command="{Binding Path=CmdRrgStepParams}" 
                                                                              CommandParameter="{Binding Path=Rrgs[1]}"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Rrgs[1].Flap.FlapView}"
                                                                      IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[1].IsFlap}" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="РРГ 3">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBox Width="40"  Margin="2" ToolTip="Заданный расход газа[л/ч]" IsReadOnly="{Binding Path=Rrgs[2].ReadOnly,Mode=OneWay}"
                                                                     
                                                                 
                                                                     Text="{Binding Path=Rrgs[2].SetupValue,UpdateSourceTrigger=PropertyChanged}" PreviewTextInput="TextBox_PreviewTextInput_5">
                                        <TextBox.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Параметры" 
                                                                              Command="{Binding Path=CmdRrgStepParams}" 
                                                                              CommandParameter="{Binding Path=Rrgs[2]}"/>
                                            </ContextMenu>
                                        </TextBox.ContextMenu>
                                    </TextBox>
                                    <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Rrgs[2].Flap.FlapView}"
                                                                      IsEnabled="{Binding Path=ClsScript.Consts.ConstRrgs[1].IsFlap}" HorizontalAlignment="Right" Height="18.125" Margin="0,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Затвор">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding Path=Shutters[0].Flaps[0].FlapView}"                                              
                                              Height="18.125" Margin="1" 
                                              Width="18.125"
                                              Style="{DynamicResource CheckBoxFlapStyle}"/>
                                    <CheckBox IsChecked="{Binding Path=Shutters[0].Flaps[1].FlapView}"                                              
                                              Height="18.125" Margin="1" 
                                              Width="18.125" VerticalAlignment="Center"
                                              Style="{DynamicResource CheckBoxFlapStyle}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    
                    <GridViewColumn Header="Клап.1" >
                        <GridViewColumn.CellTemplate  >
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[0].FlapState}" 
                                                                      Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.2">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[1].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.3">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[2].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.4">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[3].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.5">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[4].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.6">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[5].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.7">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[6].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.8">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Flaps[7].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.9">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Shutters[0].Flaps[1].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Клап.10">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <CheckBox x:Name="checkBox" Content="CheckBox" IsChecked="{Binding Path=Shutters[0].Flaps[0].FlapState}" 
                                                                     HorizontalAlignment="Right" Height="18.125" Margin="5,0,0,0" Style="{DynamicResource CheckBoxStyle1}" Width="18.125" VerticalAlignment="Center"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Загрузчик">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="checkBox" IsChecked="{Binding Path=Loaders[0].DestLoad}" Content="CheckBox" Height="24" Margin="0,0,0,1" Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24"/>
                                    <TextBox Width="30" Text="{Binding Path=Loaders[0].SetupSpeed}" Margin="1,0,0,1" PreviewTextInput="TextBox_PreviewTextInput_6"/>
                                    <CheckBox x:Name="CheckBoxUnload" IsChecked="{Binding Path=Loaders[0].DestUnload}" Content="CheckBox" Height="24" Margin="1,0,0,0" Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24" RenderTransformOrigin="0.5,0.5">
                                        <CheckBox.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform/>
                                                <SkewTransform/>
                                                <RotateTransform Angle="180"/>
                                                <TranslateTransform/>
                                            </TransformGroup>
                                        </CheckBox.RenderTransform>
                                        <CheckBox.ContextMenu>
                                            <ContextMenu>
                                                <CheckBox />
                                            </ContextMenu>
                                        </CheckBox.ContextMenu>
                                    </CheckBox>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</UserControl>
