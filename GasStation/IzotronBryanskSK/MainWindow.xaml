<Window x:Class="IzotronBryanskSK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:contr="clr-namespace:GasStation.Elements.Controllers;assembly=GasStation"
        xmlns:model="clr-namespace:GasStation.ViewModels;assembly=GasStation"
        xmlns:graph1="clr-namespace:ChartApplication;assembly=ChartApplication"
        xmlns:conv="clr-namespace:GasStation.ViewModels.Converters;assembly=GasStation"
        xmlns:newelem="clr-namespace:SoursePrj;assembly=SoursePrj"
        xmlns:newelem1="clr-namespace:SoursePrj.Брянск.Изотрон;assembly=SoursePrj"
        xmlns:userControls="clr-namespace:SoursePrj.UserControls;assembly=SoursePrj"
        xmlns:prj="clr-namespace:SoursePrj.UserControls;assembly=SoursePrj"
        MinHeight="700" MinWidth="780"
        mc:Ignorable="d"
        Title="Брянск. Изотрон средний канал (Версия 9.1 от 03.12.2019)" Height="950" Width="1373.5" Closing="Window_Closing" SizeChanged="Window_SizeChanged">
    <Window.Resources>
        <model:MainWindowViewModel x:Key="viewMod1"/>
    </Window.Resources>

    <Grid DataContext="{StaticResource viewMod1}" >
        <Grid.RowDefinitions>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="auto"/>
            <RowDefinition  MinHeight="250"  MaxHeight="1000"/>
        </Grid.RowDefinitions>
        <Grid.Background>
            <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                <GradientStop Color="#FFFDFDFD" Offset="0"/>
                <GradientStop Color="#FFAFBEAF" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Menu  DataContext="{Binding Source={StaticResource ResourceKey=viewMod1}}" Background="#FFBFCBBF">
            <MenuItem Header="Проект">
                <MenuItem Header="Создать проект"   IsEnabled="{Binding Path=ClsScript.IsViewScriptStart}" Command="{Binding Path=CmdNewProject}"/>
                <MenuItem Header="Открыть проект"   IsEnabled="{Binding Path=ClsScript.IsViewScriptStart}" Command="{Binding Path=CmdOpenScript}"/>
                <MenuItem Header="Сохранить проект" IsEnabled="{Binding Path=ClsScript.IsViewScriptStart}" Command="{Binding Path=CmdSaveScript}"/>

                <MenuItem Header="Подключение" Command="{Binding Path=CmdStartScript}" 
                                                           IsEnabled="{Binding Path=ClsScript.IsViewScriptStart}"/>
                <MenuItem Header="Отключение" Command="{Binding Path=CmdStopScript}" 
                                                           IsEnabled="{Binding Path=ClsScript.IsViewScriptStop}"/>

                <MenuItem Header="Сохранить константы" Command="{Binding Path=CmdSaveConst}" IsEnabled="{Binding Path=ClsScript.IsViewScriptStart}"/>
            </MenuItem>
            <MenuItem Header="Пользователь">
                <MenuItem Command="{Binding CmdChangeUser}" CommandParameter="User" Header="{Binding Path=ClsScript.Consts.SecuretyConst.Users[1].RusName}"/>
                <MenuItem Command="{Binding CmdChangeUser}" CommandParameter="Admin" Header="{Binding Path=ClsScript.Consts.SecuretyConst.Users[0].RusName}"/>
            </MenuItem>
        </Menu>
        <TabControl Grid.Row="0" TabStripPlacement="Bottom" DockPanel.Dock="Top" Margin="0,28,0,0">
            <TabControl.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFDFDFD" Offset="0"/>
                    <GradientStop Color="#FFAFBEAF" Offset="1"/>
                </LinearGradientBrush>
            </TabControl.Background>

            <TabItem x:Name="SchemaTab">
                <TabItem.Header>
                    <TextBlock Text="Схема" FontSize="14.667"/>
                </TabItem.Header>
                <Grid Background="#FFAFBEAF">
                    <Slider Grid.Row="0" Name="SliderScale" DataContext="{Binding Source={StaticResource viewMod1}}"  Minimum="0.1" Maximum="0.74" Value="{Binding Path=SliderValue}" Grid.ColumnSpan="2" d:LayoutOverrides="TopMargin, BottomMargin" Margin="0,0,0.334,0" >
                        <Slider.Background>
                            <RadialGradientBrush RadiusX="0.659" RadiusY="29.228" GradientOrigin="0.515,28.136">
                                <GradientStop Color="#FFC2CEC2" Offset="0.619"/>
                                <GradientStop Color="White" Offset="0.941"/>
                            </RadialGradientBrush>
                        </Slider.Background>
                    </Slider>

                    <ScrollViewer HorizontalScrollBarVisibility="Visible"  VerticalScrollBarVisibility="Visible" Background="#FFAFBEAF">
                        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

                            <Grid.LayoutTransform>
                                <ScaleTransform ScaleY="{Binding Value, ElementName=SliderScale}"  ScaleX="{Binding Value, ElementName=SliderScale}"/>
                            </Grid.LayoutTransform>
                            <newelem1:UserControl_IzotronBryanskSK
                                                            DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript.CurrStep}" Margin="-125,127,4.25,0" Background="#FFAFBEAF" HorizontalAlignment="Center" VerticalAlignment="Center" Width="1372" Height="796.833"/>

                            <userControls:UserControl_StepParams DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript}" HorizontalAlignment="Center" Height="235" Margin="381,555,0,0" VerticalAlignment="Center" Width="450"/>
                            <TextBlock  DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript}" Text="{Binding Path=Consts.ChannelConsts.NameChannel,Mode=OneWay}" TextWrapping="Wrap" FontSize="45" Margin="1387,-202,215,433" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" TextAlignment="Center" Height="120" Width="302"/>

                        </Grid>
                    </ScrollViewer>


                </Grid>
            </TabItem>

            <TabItem x:Name="GraphTab">
                <TabItem.Header>
                    <TextBlock Text="График" FontSize="14.667"/>
                </TabItem.Header>
                <DockPanel Background="#FFB3C1B3">
                    <ComboBox DockPanel.Dock="Top" Grid.Row="0" Grid.Column="1"  FontSize="20"
                                          ItemsSource="{Binding Path=ClsScript.Consts.AvalibleDevicesGraph}"
                                          SelectedItem="{Binding Path=ClsScript.SelectedGraph}"/>
                    <graph1:ControlChart Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                         PointsMas="{Binding Path=ClsScript.MasGraph}"/>
                </DockPanel>
            </TabItem>
        </TabControl>
        <GridSplitter Grid.Row="1" ShowsPreview="False" Height="3" VerticalAlignment="Center" HorizontalAlignment="Stretch" Background="#FFCFD8C1"/>
        <TabControl  Grid.Row="2" x:Name="Down" TabStripPlacement="Bottom" DockPanel.Dock="Bottom" Margin="5,10,10,1">
            <TabControl.Background>
                <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                    <GradientStop Color="#FFFDFDFD" Offset="0"/>
                    <GradientStop Color="#FFAFBEAF" Offset="1"/>
                </LinearGradientBrush>
            </TabControl.Background>
            <TabItem>
                <TabItem.Header>
                    <TextBlock Text="Управление установкой" FontSize="14.667"/>
                </TabItem.Header>
                <TabItem.Content>
                    <userControls:UserControl_StendControll MinHeight="150" DataContext="{StaticResource viewMod1}" Margin="0,0,0,3"/>
                </TabItem.Content>
            </TabItem>
            <TabItem x:Name="ProjectTab">
                <TabItem.Header>
                    <TextBlock Text="Проект" FontSize="14.667"/>
                </TabItem.Header>
                <prj:UserControlProject DataContext="{StaticResource viewMod1}"/>
            </TabItem>
            <TabItem x:Name="CtrTab" >
                <TabItem.Header>
                    <TextBlock Text="Контроллеры" FontSize="14.667"/>
                </TabItem.Header>
                <contr:UserControlControllers DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript}" RenderTransformOrigin="0,0" Margin="-1,-169,1,-171" Height="211"/>
            </TabItem>
            <TabItem x:Name="SettingsTab">
                <TabItem.Header>
                    <TextBlock Text="Настройки" FontSize="14.667"/>
                </TabItem.Header>
                
                <TreeView  DataContext="{Binding Source= {StaticResource viewMod1}, Path=ClsScript.Consts.XmlConst}" ItemsSource="{Binding XPath='settings/*'}" ItemTemplate="{DynamicResource ConstNodeTemplate}" Background="#FFB0BFB0" >
                    <TreeView.Resources>
                        <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
                    </TreeView.Resources>
                </TreeView>
            </TabItem>
        </TabControl>
    </Grid>


</Window>
