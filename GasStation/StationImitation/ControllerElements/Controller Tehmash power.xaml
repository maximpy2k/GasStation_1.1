<UserControl x:Class="StationImitation.ControllerElements.Controller_Tehmash_power"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             mc:Ignorable="d" Width="187.045" MinHeight="76.83" MaxHeight="76.83"
             >



    <Border Background="AntiqueWhite" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ТМС 7042 DO" FontSize="16" Margin="5" Foreground="Black"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>

            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="35">
                <Grid Height="auto">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Значение" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                    <TextBox Grid.Column="1" Margin="5" Text="{Binding Path=SetPower,Mode=OneWay}"/>

                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
