<UserControl x:Class="StationImitation.ControllerElements.Controller_Tehmash_ports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             mc:Ignorable="d" 
             d:DesignHeight="88" Width="141.875">



    <Border Background="AntiqueWhite" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ТМС 7042 DO" FontSize="16" Margin="5" Foreground="Black"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>

            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="45">
                <Grid Height="auto">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3" 
                              IsChecked="{Binding Path=DioValues[0],Mode=OneWay}" IsEnabled="False"/>


                    <TextBlock Grid.Row="1" Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3" 
                              IsChecked="{Binding Path=DioValues[1],Mode=OneWay}" IsEnabled="False"/>






                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
