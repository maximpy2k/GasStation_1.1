<UserControl x:Class="StationImitation.ControllerElements.Controller_7018"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             mc:Ignorable="d" 
             Height="235" Width="143.794">

    <Border Background="AntiqueWhite" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ICPDAS 7018" FontSize="14" Margin="2" Foreground="Black"/>
                <TextBlock x:Name="ContrNum" Text="" FontSize="14" Margin="2" Foreground="Black" HorizontalAlignment="Center"/>
            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10">
                <Grid Height="auto">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Канал 0" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="0" Grid.Column="1"  Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="0" Grid.Column="2"  Margin="3" Text="{Binding Path=AcpValues[0]}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Канал 1" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="1" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[1]}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Канал 2" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="2" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[2]}"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Канал 3" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="3" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[3]}"/>

                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Канал 4" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="4" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="4" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[4]}"/>

                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Канал 5" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="5" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="5" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[5]}"/>

                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Канал 6" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="6" Grid.Column="1" Margin="3" Text="mV" IsEnabled="False"/>
                    <TextBox   Grid.Row="6" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[6]}"/>

                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Канал 7" VerticalAlignment="Center" HorizontalAlignment="Center" IsEnabled="False"/>
                    <TextBox   Grid.Row="7" Grid.Column="1" Margin="3" IsEnabled="False" Text="mV"/>
                    <TextBox   Grid.Row="7" Grid.Column="2" Margin="3" Text="{Binding Path=AcpValues[7]}"/>

                </Grid>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
