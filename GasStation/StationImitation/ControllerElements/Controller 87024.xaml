<UserControl x:Class="StationImitation.ControllerElements.Controller_87024"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             mc:Ignorable="d" 
             Height="150" Width="124.83">

    <Border Background="AntiqueWhite" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="ICPDAS 87024" FontSize="16" Margin="5" Foreground="Black"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>
            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10">
                <Grid Height="auto">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Вх 0" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox   Grid.Row="0" Grid.Column="1"  Margin="3" Text="{Binding Path=CapValues[0]}" IsEnabled="False"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Вх 1" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="3" Text="{Binding Path=CapValues[1]}" IsEnabled="False"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Вх 2" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="3" Text="{Binding Path=CapValues[2]}" IsEnabled="False"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Вх 3" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="3" Text="{Binding Path=CapValues[3]}" IsEnabled="False"/>



                </Grid>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
