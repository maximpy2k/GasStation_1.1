<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StationImitation"
             xmlns:ViewModel="clr-namespace:StationImitation.ViewModel" x:Class="StationImitation.UserControl_OpenPorts"
             mc:Ignorable="d" 
             d:DesignHeight="134" d:DesignWidth="210">
    <UserControl.Resources>
        <ViewModel:MainWindowViewModel x:Key="viewMod1"/>
    </UserControl.Resources>
    <Grid>

        <GroupBox d:LayoutOverrides="Width, Height" Width="210" VerticalAlignment="Bottom" Margin="0,0,-0,-0
                  " Height="134" HorizontalAlignment="Right" Header="Настройки">
            <Grid VerticalAlignment="Center" Margin="0" HorizontalAlignment="Center">
                <Grid Width="155.556" VerticalAlignment="Center" Margin="30.722,22.218,30.722,28.217" Height="59.605" HorizontalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="19.96"/>
                        <RowDefinition Height="Auto" MinHeight="19.96"/>
                        <RowDefinition Height="Auto" MinHeight="19.96"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="textBox_sp2" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Text="COM18" TextWrapping="Wrap" Grid.Row="1" Margin="15.954,0"/>
                    <Button x:Name="buttonSp2" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Grid.Row="1" Margin="12.528,0" Grid.Column="1" Content="Открыть"/>
                    <TextBox x:Name="textBox_sp3" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Text="COM19" TextWrapping="Wrap" Grid.Row="2" Margin="15.954,0"/>
                    <Button x:Name="buttonSp3" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Grid.Row="2" Margin="12.528,0" Grid.Column="1" Content="Открыть" />
                    <TextBox x:Name="textBox_sp1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Text="COM1" TextWrapping="Wrap" Grid.Row="0" Margin="15.954,0" Grid.Column="0"/>
                    <Button x:Name="buttonSp1" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin" Margin="12.528,0" Command="{Binding Path=CmdOpenPort}" Grid.Column="1" Content="Открыть"/>
                </Grid>
            </Grid>
        </GroupBox>

    </Grid>
</UserControl>
