<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:StationImitation.UserControls"
             xmlns:ViewModel="clr-namespace:StationImitation.ViewModel" xmlns:Commands="clr-namespace:GasStation.ModalWindows.Commands;assembly=GasStation" x:Class="StationImitation.UserControls.ControlConsts"
             mc:Ignorable="d" Width="175" Height="300">
    <UserControl.Resources>
        <ViewModel:MainWindowViewModel x:Key="viewMod1"/>

        <HierarchicalDataTemplate x:Key="ConstNodeTemplate" ItemsSource="{Binding XPath=./*}">
            <HierarchicalDataTemplate.Resources>
                <Commands:CommandOpenTable x:Key="cmdOpen"/>
                <ContextMenu x:Key="TableMenu">
                    <MenuItem Header="Таблица" Command="{Binding Source={StaticResource cmdOpen}}" CommandParameter="{Binding}"/>
                </ContextMenu>
            </HierarchicalDataTemplate.Resources>
            <StackPanel Orientation="Vertical">
                <StackPanel x:Name="node"  Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="node_txt"/>
                    <TextBlock Text="  "/>
                    <TextBlock x:Name="node_num"/>
                </StackPanel>
                <StackPanel x:Name="par1"  Orientation="Horizontal" Visibility="Collapsed">
                    <TextBlock x:Name="par1_txt"  Width="70"/>
                    <TextBox   x:Name="par1_val" Width="80"/>
                </StackPanel>

                <Grid x:Name="grid" Visibility="Collapsed" Width="120" Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <TextBox   Grid.Row="1" Grid.Column="0" x:Name="field11_val" Width="80" Margin="3"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" x:Name="field12_val" Width="80" Margin="3"/>
                </Grid>
            </StackPanel>

            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="securety">
                    <Setter TargetName="node" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="node_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="node_txt" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="node_num" Property="Text" Value="{Binding XPath=@num}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="user">
                    <Setter TargetName="node" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="node_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="node_txt" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="node_num" Property="Text" Value="{Binding XPath=@userName}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="priv">
                    <Setter TargetName="node" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="node_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="node_txt" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="node_num" Property="Text" Value="{Binding XPath=@num}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="dev">
                    <Setter TargetName="node" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="node_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="node_txt" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="node_num" Property="Text" Value="{Binding XPath=@num}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="table">
                    <Setter TargetName="node" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="node_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="node_txt" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="node_num" Property="Text" Value="{Binding XPath=@num}"/>
                    <Setter TargetName="node" Property="ContextMenu" Value="{StaticResource TableMenu}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="EditFild">
                    <Setter TargetName="par1" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="par1_txt" Property="Text" Value="{Binding XPath=@rusName}"/>
                    <Setter TargetName="par1_val" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="par1_val" Property="Text" Value="{Binding Mode=TwoWay, XPath=@value}"/>
                </DataTrigger>

                <DataTrigger Binding="{Binding Name}" Value="field">
                    <Setter TargetName="grid" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="field11_val" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="field11_val" Property="Text" Value="{Binding XPath=@valueX}"/>

                    <Setter TargetName="field12_val" Property="ToolTip" Value="{Binding XPath=@def}"/>
                    <Setter TargetName="field12_val" Property="Text" Value="{Binding XPath=@valueY}"/>
                </DataTrigger>

            </HierarchicalDataTemplate.Triggers>

        </HierarchicalDataTemplate>

    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="4*"/>
            <RowDefinition Height="21*"/>
        </Grid.RowDefinitions>
        <TreeView Grid.Row="1" Margin="5"   ItemsSource="{Binding XPath=settings/*}" ItemTemplate="{DynamicResource ConstNodeTemplate}" Background="#FFB0BFB0" DataContext="{Binding Path=ConstView.ClassXmlConst.XmlConst}">
            <TreeView.Resources>
                <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
            </TreeView.Resources>
            <!--<TreeView.DataContext>
                <Binding Path="ClassXmlConst.XmlConst"/>
            </TreeView.DataContext>-->
        </TreeView>
        <StackPanel Grid.Row="0" Orientation="Vertical" Margin="0" d:LayoutOverrides="LeftMargin, RightMargin, TopMargin, BottomMargin">
            <StackPanel Orientation="Horizontal" Height="28.461" Margin="5,0">
                <TextBlock d:LayoutOverrides="VerticalAlignment, LeftMargin, RightMargin" Width="95.317" Text="Путь к констатам" Margin="0,2.667,0,5.538"/>
                <Button Width="59.374" VerticalAlignment="Top" Margin="10,2.667,5,0" Height="20.256" Command="{Binding CmdOpenConst}" Content="Обзор" HorizontalAlignment="Right" Click="Button_Click"/>
            </StackPanel>
            <TextBox Height="17.293" Margin="5,0" Text="{Binding Path}"/>
        </StackPanel>

    </Grid>
</UserControl>
