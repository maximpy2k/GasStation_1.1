<Window x:Class="GasStation.ModalWindows.View.WindowHydrogenBurnerView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View"
        xmlns:elem="clr-namespace:GasStation.UserControls.UserControlsView"
        xmlns:graph="clr-namespace:ChartApplication;assembly=ChartApplication"
        mc:Ignorable="d"
        Title="Расширенная информация горелки" Height="446.36" Width="650" Closing="Window_Closing">
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Height="100" Width="200" ShowGridLines="True" Margin="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <!--<RowDefinition />-->
                <RowDefinition />
                <RowDefinition />
                <RowDefinition/>
            </Grid.RowDefinitions>

            <!--<graph:ControlChart Grid.Row="0" Grid.Column="1" Grid.RowSpan="3"
                            DataContext="{Binding SecView}"
                            Line0="{Binding SeriesTdOut}"
                            Line1="{Binding SeriesTdIn}"
                            Line2="{Binding SeriesCurrSetTemp}" Margin="0,0,266,-60"/>-->

            <TextBlock Grid.Row="0" Grid.Column="0" Margin="4" Text="Термодатчик горелки"/>
            <TextBox  IsReadOnly="True" Grid.Row="0" Grid.Column="1" Margin="4"
                 Text="{Binding Path = HydrogenBurnerView.TdHeaterHydrogenBurner}"/>

            <TextBlock Visibility="{Binding HydrogenBurnerView.VisibleTdFire}" Grid.Row="1" Grid.Column="0" Margin="4" Text="Термодатчик пламени"/>
            <TextBox Visibility="{Binding HydrogenBurnerView.VisibleTdFire}" IsReadOnly="True" Grid.Row="1" Grid.Column="1" Margin="4"
                 Text="{Binding Path=HydrogenBurnerView.TdFire}"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Margin="4" Text="Нагрев"/>
            <CheckBox Grid.Row="2" Grid.Column="1" Margin="4" HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsChecked="{Binding Path=Heat}"/>
        </Grid>
        <graph:ControlChart x:Name="chart1" Grid.Column="1" Margin="5" 
            Line0="{Binding Path=HydrogenBurnerView.SeriesTdHeaterHydrogenBurner}"
            Line1="{Binding Path=HydrogenBurnerView.SeriesTdFire}"/>
    </Grid>

</Window>
