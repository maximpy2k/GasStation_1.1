<Window x:Class="GasStation.ModalWindows.View.WindowHydrogenBurnerPidView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View"
        xmlns:elem="clr-namespace:GasStation.UserControls.UserControlsView"
        xmlns:graph="clr-namespace:ChartApplication;assembly=ChartApplication"
        xmlns:userControlsView="clr-namespace:GasStation.UserControls.UserControlsView"
        mc:Ignorable="d"
        Title="Расширенная информация горелки" Height="446.36" Width="926" Closing="Window_Closing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <userControlsView:PidRegulator  DataContext="{Binding Path=HydrogenBurnerView.DataHydrogen.ClassPidOut}" />

        <graph:ControlChart x:Name="chart1" Grid.Column="1" Margin="5" 
            Line0="{Binding Path=HydrogenBurnerView.SeriesTdHeaterHydrogenBurner}"
            Line1="{Binding Path=HydrogenBurnerView.SeriesTdFire}"
            Line2="{Binding Path=HydrogenBurnerView.SeriesSetTemp}"/>
    </Grid>

</Window>
