<Window x:Class="GasStation.ModalWindows.View.WindowFlapParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View"
        mc:Ignorable="d"
        Title="Настройки клапана" Height="125.823" Width="300">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label FontSize="22" Content="Клапан  №" Margin="5"></Label>
            <Label FontSize="22" DataContext="{Binding}" Content="{Binding Path=Num}" Margin="5"></Label>
        </StackPanel>
        <CheckBox Content="Закрытие клапана"
                  IsEnabled="{Binding EnabledChangedScript}"
                  IsChecked="{Binding  Path=FlapState}"/>

        <CheckBox Content="Разрешение пользователю изменять свойства"  IsChecked="{Binding Path=UsePriv}" IsEnabled="{Binding Path=EnabledChangedScript}"/>
    </StackPanel>
</Window>
