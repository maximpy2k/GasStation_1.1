<Window x:Class="GasStation.ModalWindows.View.WindowThermoChamberParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
        mc:Ignorable="d"
        xmlns:commands ="clr-namespace:GasStation.ModalWindows.Commands"
        Title="Настройки термокамеры" Height="382.954" Width="816.564">
    <Window.Resources>
        <converters:ClassConverterRegime x:Key="ConvRegime"/>
        <commands:CommandOpenTable x:Key="cmdOpen"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270*" />
            <ColumnDefinition Width="320*"/>
            <ColumnDefinition Width="270*"/>
        </Grid.ColumnDefinitions>

        <GroupBox Grid.Column="1" Margin="2,2,0,2" >
            <GroupBox.Header>
                <TextBlock Text="Настройки термокамеры" FontSize="20"/>
            </GroupBox.Header>
            <StackPanel Margin="0,0,-2,0" >
                <StackPanel Orientation="Horizontal" Margin="2" HorizontalAlignment="Left">
                    <Label Height="30"  Width="140"  Content="Заданная температура"/>
                    <TextBox IsEnabled="{Binding EnabledChangedScript}" Height="30" Width="60" Margin="2" Text="{Binding Path=SetupTemp}"/>
                </StackPanel>
                <CheckBox IsEnabled="{Binding EnabledChangedScript}" Height="30" Margin="2" Content="Включение нагрева" HorizontalAlignment="Left" IsChecked="{Binding Heat}"/>

                <CheckBox Content="Разрешение пользователю изменять свойства" IsChecked="{Binding Path=UsePriv}" IsEnabled="{Binding Path=EnabledChangedScript}"/>

            </StackPanel>
        </GroupBox>


        <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Grid.ColumnSpan="2" Margin="51,84,0,10">
        </StackPanel>

        <StackPanel Width="250" Grid.Column="0" Grid.Row="1" Margin="2,0">
            <StackPanel Orientation="Horizontal">
                <Label FontSize="22" Content="Термосекция №" Margin="5"></Label>
                <Label FontSize="22" Content="{Binding Path=ChamberSections[0].Num}" Margin="5"></Label>
            </StackPanel>

            <ComboBox Height="20" Margin="5" 
                  ItemsSource="{Binding Source={StaticResource ConvRegime},Path=Items}"
                  IsEnabled="{Binding EnabledChangedScript}"
                  Text="{Binding Path=ChamberSections[0].TypeReg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,  Converter={StaticResource ConvRegime}}"/>

            <GroupBox>
                <StackPanel>
                    <RadioButton 
                                 IsEnabled="{Binding EnabledChangedScript}" 
                                 Margin="5" 
                                 IsChecked="{Binding Path=ChamberSections[0].UsePid}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Двухкаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton IsEnabled="{Binding EnabledChangedScript}" Margin="5" IsChecked="{Binding Path=ChamberSections[0].UseSetThermo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Однокаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Button  Margin="2" Content="Таблица корректировки"
                                     Command="{Binding Path=ChamberSections[0].CmdOpenTable}" 
                                     CommandParameter="{Binding Path='ChamberSections[0]'}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Height="20"  Width="140" Margin="2" Text="Заданная температура"/>
                <TextBox Height="20" Width="60" IsEnabled="False" Margin="2" Text="{Binding Path=ChamberSections[0].SetupTemp, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Width="250" Grid.Column="1" Grid.Row="1" Margin="2,0">
            <StackPanel Orientation="Horizontal">
                <Label FontSize="22" Content="Термосекция №" Margin="5"></Label>
                <Label FontSize="22" Content="{Binding Path=ChamberSections[1].Num}" Margin="5"></Label>
            </StackPanel>

            <ComboBox Height="20" Margin="5" 
                  ItemsSource="{Binding Source={StaticResource ConvRegime},Path=Items}"
                  IsEnabled="{Binding EnabledChangedScript}"
                  Text="{Binding Path=ChamberSections[1].TypeReg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,  Converter={StaticResource ConvRegime}}"/>

            <GroupBox>
                <StackPanel>
                    <RadioButton IsEnabled="{Binding EnabledChangedScript}" Margin="5" IsChecked="{Binding Path=ChamberSections[1].UsePid}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Двухкаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsEnabled="{Binding EnabledChangedScript}" Margin="5" IsChecked="{Binding Path=ChamberSections[1].UseSetThermo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Однокаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Button  Margin="1,2,3,2" Content="Таблица корректировки"
                                     Command="{Binding Path=ChamberSections[1].CmdOpenTable}" 
                                     CommandParameter="{Binding Path='ChamberSections[1]'}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Height="20"  Width="140" Margin="2" Text="Заданная температура"/>
                <TextBox Height="20" Width="60" Margin="2" IsEnabled="False" Text="{Binding Path=ChamberSections[1].SetupTemp, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>

        <StackPanel Width="250" Grid.Column="2" Grid.Row="1" Grid.ColumnSpan="3" Margin="2,0">
            <StackPanel Orientation="Horizontal">
                <Label FontSize="22" Content="Термосекция №" Margin="5"></Label>
                <Label FontSize="22" Content="{Binding Path=ChamberSections[2].Num}" Margin="5"></Label>
            </StackPanel>

            <ComboBox Height="20" Margin="5" 
                  ItemsSource="{Binding Source={StaticResource ConvRegime},Path=Items}"
                  IsEnabled="{Binding EnabledChangedScript}"
                  Text="{Binding Path=ChamberSections[2].TypeReg, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged,  Converter={StaticResource ConvRegime}}"/>

            <GroupBox>
                <StackPanel>
                    <StackPanel Orientation="Horizontal"/>
                    <RadioButton IsEnabled="{Binding EnabledChangedScript}" Margin="5" IsChecked="{Binding Path=ChamberSections[2].UsePid}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Двухкаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton IsEnabled="{Binding EnabledChangedScript}" Margin="5" IsChecked="{Binding Path=ChamberSections[2].UseSetThermo}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Однокаскадный ПИД регулятор" Margin="2" VerticalAlignment="Center"/>
                        </StackPanel>
                    </RadioButton>
                    <Button  Margin="2" Content="Таблица корректировки"
                                     Command="{Binding Path=ChamberSections[2].CmdOpenTable}" 
                                     CommandParameter="{Binding Path='ChamberSections[2]'}"/>
                </StackPanel>
            </GroupBox>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Height="20"  Width="140" Margin="2" Text="Заданная температура"/>
                <TextBox Height="20" Width="60" Margin="2" IsEnabled="False" Text="{Binding Path=ChamberSections[2].SetupTemp, Mode=OneWay}" IsReadOnly="True"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
