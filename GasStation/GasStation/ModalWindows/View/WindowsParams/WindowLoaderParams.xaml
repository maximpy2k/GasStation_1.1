<Window x:Class="GasStation.ModalWindows.View.WindowLoaderParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View"
        mc:Ignorable="d"
        Title="Настройки загрузчика" Height="130.126" Width="300">

    <StackPanel>
        <StackPanel.Resources>
            <ResourceDictionary Source="/GasStation;component/Styles/HierarchicalDataTemplate/ConstDictionary.xaml"/>
        </StackPanel.Resources>
        
        <StackPanel Orientation="Horizontal">
            <Label FontSize="22" Content="Загрузчик  №" Margin="5"></Label>
            <Label FontSize="22" DataContext="{Binding}" Content="{Binding Path=Num}" Margin="5"></Label>
        </StackPanel>
        <StackPanel Orientation="Horizontal" >
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="checkBox" IsChecked="{Binding Path=DestLoad}" Content="CheckBox" Height="24" Margin="0,0,0,1" 
                              Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24"/>
                <TextBox Width="30" Text="{Binding Path=SetupSpeed,UpdateSourceTrigger=PropertyChanged}" Margin="1,0,0,1"/>

                <CheckBox x:Name="CheckBoxUnload" 
                                                                      IsChecked="{Binding Path=DestUnload}" Content="CheckBox" Height="24" Margin="1,0,0,0" Style="{DynamicResource CheckBoxLoad}" VerticalAlignment="Bottom" Width="24" RenderTransformOrigin="0.5,0.5">
                    <CheckBox.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform/>
                            <SkewTransform/>
                            <RotateTransform Angle="180"/>
                            <TranslateTransform/>
                        </TransformGroup>
                    </CheckBox.RenderTransform>
                    <CheckBox.ContextMenu>
                        <ContextMenu>
                            <CheckBox />
                        </ContextMenu>
                    </CheckBox.ContextMenu>
                </CheckBox>
            </StackPanel>
        </StackPanel>

        <CheckBox Content="Разрешение пользователю изменять свойства" IsChecked="{Binding Path=UsePriv,Mode=TwoWay}" IsEnabled="{Binding Path=EnabledChangedScript}"></CheckBox>
    </StackPanel>
</Window>
