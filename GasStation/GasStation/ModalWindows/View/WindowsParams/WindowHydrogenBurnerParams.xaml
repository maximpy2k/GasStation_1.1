<Window x:Class="GasStation.ModalWindows.View.WindowsParams.WindowHydrogenBurnerParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GasStation.ModalWindows.View.WindowsParams"
        xmlns:conv="clr-namespace:GasStation.ViewModels.Converters"
        mc:Ignorable="d"
        Title="Настройки горелки" Height="170.114" Width="300">
    <Window.Resources>
        <conv:ClassConverterRegime x:Key="ConvRegime"/>
    </Window.Resources>
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label FontSize="22" Content="Горелка №" Margin="5"></Label>
            <Label FontSize="22" DataContext="{Binding}" Content="{Binding Path=Num}" Margin="5"></Label>
        </StackPanel>
        <ComboBox Height="20" Margin="5" ItemsSource="{Binding Source={StaticResource ConvRegime}, Path=Items}"
  IsEnabled="{Binding EnabledChangedScript}"
  Text="{Binding Path = TypeReg, Mode=TwoWay, Converter={StaticResource ConvRegime}}"/>
        <CheckBox Content="Нагрев"
                  IsEnabled="{Binding EnabledChangedScript}"
                  IsChecked="{Binding  Path=Heat}"/>
        <CheckBox Content="Использовать ПИД"
                  IsEnabled="{Binding EnabledChangedScript}"
                  IsChecked="{Binding  Path=UsePid}"/>
        <CheckBox Content="Разрешение пользователю изменять свойства"  IsChecked="{Binding Path=UsePriv}" IsEnabled="{Binding Path=EnabledChangedScript}"/>
    </StackPanel>
</Window>
