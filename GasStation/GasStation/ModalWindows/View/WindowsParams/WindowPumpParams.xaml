<Window x:Class="GasStation.ModalWindows.View.WindowPumpParams"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Настройки системы создания вакуума" Height="155.189" Width="495.253">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label FontSize="22" Content="{Binding Path=PumpSysConst.RusName}" Margin="5"></Label>
            <Label FontSize="22" DataContext="{Binding}" Content="{Binding Path=Num}" Margin="5"></Label>
        </StackPanel>
        <CheckBox Content="{Binding  Path=WorkVacuumPump}"
                  IsEnabled="{Binding EnabledChangedScript}"
                  IsChecked="{Binding  Path=UseVacuumPump}"/>
        <CheckBox Content="{Binding  Path=WorkRoughingPump}"
                  IsEnabled="{Binding EnabledChangedScript}"
                  IsChecked="{Binding  Path=UseRoughingPump}"/>        
        <CheckBox Content="Разрешение пользователю изменять свойства"  IsChecked="{Binding Path=UsePriv}" IsEnabled="{Binding Path=EnabledChangedScript}"/>
    </StackPanel>
</Window>
