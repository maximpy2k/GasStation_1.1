<UserControl x:Class="GasStation.Elements.Controllers.Controller_Shim"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
             mc:Ignorable="d" Width="113" MaxHeight="60.7" Height="64"
>
    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
    </UserControl.Resources>


    <Border Background="{Binding Path=Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal" Height="17">
                <TextBlock Text="TM Shim" FontSize="10" Margin="5,1,0,4" Foreground="Black" FontWeight="Bold"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>

            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="32">
                <Grid Height="auto" Margin="0,0,0,-3">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Время, с" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="7,6,7,11" FontSize="9"/>
                    
                    <TextBox Grid.Column="1" Margin="5,4,5,6" Text="{Binding Path=ViewValue,Mode=OneWay}" IsEnabled="False"/>

                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
