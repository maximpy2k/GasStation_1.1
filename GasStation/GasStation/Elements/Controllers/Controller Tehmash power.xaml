<UserControl x:Class="GasStation.Elements.Controllers.Controller_Tehmash_power"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
             mc:Ignorable="d" Width="135" Height="64">

    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
    </UserControl.Resources>

    <Border Background="{Binding Path=Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="3" CornerRadius="10" >

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal" Height="17">
                <TextBlock Text="ТМС 7042 DO" FontSize="10" Margin="5,2,5,3" Foreground="Black" FontWeight="Bold" Height="12"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>

            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="35">
                <Grid Height="auto">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Мощность, %" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9"/>
                    <ProgressBar Grid.Column="1" Margin="5" Minimum="0" Maximum="4095" Value="{Binding Path=ViewPower,Mode=OneWay}"/>

                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
