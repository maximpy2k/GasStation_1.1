<UserControl x:Class="GasStation.Elements.Controllers.Controller_87024"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
             mc:Ignorable="d" 
             Height="118" Width="98">
    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
    </UserControl.Resources>
    <Border Background="{Binding Path=Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3,3,3,-3">
            <StackPanel Orientation="Horizontal" Height="17" Margin="0,0,10,0">
                <TextBlock Text="ICPDAS 87024" FontSize="10" Margin="2" Foreground="Black" Height="14" FontWeight="Bold"/>
                <TextBlock Name="ContrNum" Text="" FontSize="10" Margin="2" Foreground="Black" FontWeight="Bold" Width="15"/>
            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="88">
                <Grid Height="69">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" MinWidth="26"/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>

                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Вх 0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" Height="12" Margin="2,4,7,1" Width="17"/>
                    <TextBox   Grid.Row="0" Grid.Column="1"  Margin="3,3,3,0" Text="{Binding Path=CapValues[0]}" IsEnabled="False" FontSize="8"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Вх 1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" Height="12" Margin="2,4,8,1" Width="16"/>
                    <TextBox   Grid.Row="1" Grid.Column="1" Margin="3,3,3,0" Text="{Binding Path=CapValues[1]}" IsEnabled="False" FontSize="8"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Вх 2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" Height="12" Margin="2,4,8,2" Width="16"/>
                    <TextBox   Grid.Row="2" Grid.Column="1" Margin="3,3,3,0" Text="{Binding Path=CapValues[2]}" IsEnabled="False" FontSize="8"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Вх 3" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="9" Height="12" Margin="2,3,8,2" Width="16"/>
                    <TextBox   Grid.Row="3" Grid.Column="1" Margin="3,3,3,0" Text="{Binding Path=CapValues[3]}" IsEnabled="False" FontSize="8"/>



                </Grid>
            </Border>
        </StackPanel>
    </Border>

</UserControl>
