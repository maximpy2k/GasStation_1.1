<UserControl x:Class="GasStation.Elements.Controllers.Controller_Tehmash_ports"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
             mc:Ignorable="d" Width="113" Height="64">

    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
    </UserControl.Resources>

    <Border Background="{Binding Path=Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Margin="0,0,0,-4">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal" Height="17">
                <TextBlock Text="ТМС 7042 DO" FontSize="10" Margin="5,1" Foreground="Black" FontWeight="Bold" Height="15"/>
                <TextBlock Name="ContrNum" Text="" FontSize="16" Margin="5" Foreground="Black"/>

            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="39">
                <Grid Height="auto" Margin="0,0,0,2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[0],Mode=OneWay}" IsEnabled="False" Width="15" Height="15"/>


                    <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="21,15,21,1" Grid.RowSpan="2"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[1],Mode=OneWay}" IsEnabled="False" Width="15" Height="15"/>






                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
