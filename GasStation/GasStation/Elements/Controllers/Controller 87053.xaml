<UserControl x:Class="GasStation.Elements.Controllers.Controller_87053"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:GasStation.Elements.Controllers"
             xmlns:converters="clr-namespace:GasStation.ViewModels.Converters"
             mc:Ignorable="d" Width="113" Height="186">

    <UserControl.Resources>
        <converters:ClassConverterColor x:Key="colorConverter"/>
    </UserControl.Resources>
    <Border Background="{Binding Path=Avalible, Converter={StaticResource colorConverter}}" BorderBrush="Black" BorderThickness="3" CornerRadius="10">

        <StackPanel Margin="3">
            <StackPanel Orientation="Horizontal" Height="17">
                <TextBlock Text="ICPDAS 87053 DI" FontSize="10" Margin="2" Foreground="Black" FontWeight="Bold"/>
                <TextBlock Name="ContrNum" Text="" FontSize="10" Margin="2" Foreground="Black" FontWeight="Bold"/>
            </StackPanel>
            <Border Background="CornflowerBlue" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Height="156" >
                <Grid Margin="0,10,0,5">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="1*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="0" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Height="20" Margin="0"/>
                    <CheckBox Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsChecked="{Binding Path=DioValues[0]}" IsEnabled="False" Width="15" Height="15" Margin="0"/>
                    <TextBlock Grid.Row="0" Grid.Column="3" Text="8" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Height="20" Margin="5,-2,6,14" Grid.RowSpan="2"/>
                    <CheckBox Grid.Row="0" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" 
                              IsChecked="{Binding Path=DioValues[8]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock Grid.Column="0" Text="1" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Height="20" Margin="0,0,0,1" Grid.Row="1"/>
                    <CheckBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" 
                              IsChecked="{Binding Path=DioValues[1]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock Grid.Column="3" Text="9" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="20" Grid.Row="1" />
                    <CheckBox Grid.Row="1" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center"
                              IsChecked="{Binding Path=DioValues[9]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="2" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="14" Height="19" Margin="0,0,0,1"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[2]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock Grid.Row="2" Grid.Column="3" Text="10" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19" />
                    <CheckBox Grid.Row="2" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[10]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock  Grid.Row="3" Grid.Column="0" Text="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="20"/>
                    <CheckBox Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[3]}" IsEnabled="False" Width="15" Height="15" FontSize="6"/>
                    <TextBlock  Grid.Row="3" Grid.Column="3" Text="11" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="20" />
                    <CheckBox Grid.Row="3" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[11]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock  Grid.Row="4" Grid.Column="0" Text="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19"/>
                    <CheckBox Grid.Row="4" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[4]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock  Grid.Row="4" Grid.Column="3" Text="12" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19" />
                    <CheckBox Grid.Row="4" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[12]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock  Grid.Row="5" Grid.Column="0" Text="5" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19"/>
                    <CheckBox Grid.Row="5" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[5]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock  Grid.Row="5" Grid.Column="3" Text="13" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19" />
                    <CheckBox Grid.Row="5" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[13]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock  Grid.Row="6" Grid.Column="0" Text="6" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19" />
                    <CheckBox Grid.Row="6" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[6]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock  Grid.Row="6" Grid.Column="3" Text="14" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="19" />
                    <CheckBox Grid.Row="6" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[14]}" IsEnabled="False" Width="15" Height="15"/>

                    <TextBlock  Grid.Row="7" Grid.Column="0" Text="7" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="20"/>
                    <CheckBox Grid.Row="7" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[7]}" IsEnabled="False" Width="15" Height="15"/>
                    <TextBlock  Grid.Row="7" Grid.Column="3" Text="15" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,1" FontSize="14" Height="20"/>
                    <CheckBox Grid.Row="7" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" 
                              IsChecked="{Binding Path=DioValues[15]}" IsEnabled="False" Width="15" Height="15"/>

                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
