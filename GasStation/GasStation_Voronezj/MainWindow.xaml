                            </Grid.LayoutTransform>
                            <newelem:UserControl_Voronezj
                                                            DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript.CurrStep}" Margin="-77,32,4.25,0" Background="#FFAFBEAF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <userControls:UserControl_StepParams DataContext="{Binding Source={StaticResource viewMod1},Path=ClsScript}" HorizontalAlignment="Center" Height="245" Margin="948,-575,0,0" VerticalAlignment="Center" Width="450"/>

                        </Grid>
                    </ScrollViewer>


                </Grid>
            </TabItem>

            <TabItem x:Name="GraphTab">
